# Raw dataset (huge; not meant to be committed — download/extract locally)
data/
*.tsv
*.parquet

# Model artifacts / caches
*.pkl
*.joblib
*.bin
__pycache__/
*.pyc
.ipynb_checkpoints/

# Outputs (regenerate via pipeline; keep small samples only if needed)
output/*.tsv

# The assembled final-submission zip (hundreds of MB -- includes the huge
# output TSVs above; GitHub hard-blocks any push over 100MB anyway).
# Delivered to the user directly from the working directory instead.
submission.zip

# Scratch experiment directories (re-run outputs, OOF checkpoints for
# decode-strategy testing) -- not part of the committed deliverable.
output_improve/
output_test/

# Gemini-notebook-derived pipeline: working/output dirs are regenerable
# run artifacts (dicts, parquet checkpoints, predictions) -- only the
# source code under gemini_pipeline/src is a committed deliverable.
gemini_work/
gemini_out/
